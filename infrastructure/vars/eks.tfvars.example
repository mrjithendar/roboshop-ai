# Copy to a private .tfvars file and pass AFTER vars/dev.tfvars.
eks_enabled = true
eks_version = "1.36"
eks_admin_principal_arns = ["arn:aws:iam::881026659929:role/REPLACE_WITH_YOUR_ADMIN_ROLE"]
# Use your own admin/runner public address. Empty = private-only API.
eks_public_access_cidrs = ["203.0.113.10/32"]
eks_node_instance_types = ["t3.large"]
eks_node_count = 2

# For private-only API: set public CIDRs to [] and allow the connected runner address.
# eks_private_access_cidrs = ["10.20.0.5/32"]
