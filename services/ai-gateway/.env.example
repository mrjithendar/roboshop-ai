# Copy to .env.local and supply local-only service credentials (at least 32 chars).
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE=roboshop_gateway_test
COMMERCE_BACKEND=json
DATA_DIR=/tmp/roboshop-gateway-local-ledger
USER_URL=http://127.0.0.1:4109
USER_SERVICE_TOKEN=
CATALOGUE_URL=http://127.0.0.1:4108
LLM_SERVICE_TOKEN=
# Optional services; no provider is configured by default.
AGENT_URL=http://127.0.0.1:4103
OLLAMA_ENDPOINTS_JSON={}
PAYMENT_SERVICE_TOKEN=
CHECKOUT_CURRENCIES=INR,USD,GBP,SGD,AUD
# Set CART_URL + CART_SERVICE_TOKEN to use the isolated Redis cart service.
# PostgreSQL additionally requires COMMERCE_DATABASE_URL and initialized schema.
