# Same service-owned build context as mcp-server; separate operational identity.
FROM node:26.12.1-bookworm-slim AS telemetry
WORKDIR /opt/openclaw-plugins
COPY operations/plugins/package*.json ./
RUN npm ci --ignore-scripts --legacy-peer-deps --omit=dev --no-audit --no-fund

FROM python:3.14.0-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY operations/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 1000 --create-home app
COPY --from=telemetry /opt/openclaw-plugins /opt/openclaw-plugins
COPY --chown=1000:1000 operations ./operations
USER 1000:1000
EXPOSE 4180
CMD ["uvicorn", "operations.server:create_app", "--factory", "--host", "0.0.0.0", "--port", "4180", "--no-access-log"]
