# Copy to env/<cluster-name>.env and edit. No secrets belong in this file.
# Terraform outputs (cluster name, region, VPC, queue, node role, registry, log group) are read
# automatically from ./terraform; only reader choices live here.

# Must match terraform `name` and `region`.
CLUSTER_NAME=roboshop-demo
AWS_REGION=<region>
ENVIRONMENT=demo
OWNER=<your-name-or-team>

# Public hostname served by the NLB, e.g. shop.example.com (a name in ROUTE53_ZONE_ID's zone).
PUBLIC_HOST=<shop.example.com>
ACME_EMAIL=<you@example.com>
ROUTE53_ZONE_ID=<hosted-zone-id>
CERT_ISSUER=letsencrypt-staging          # switch to letsencrypt-prod after H3
INGRESS_SOURCE_CIDR=0.0.0.0/0            # or your /32 while testing

# Image tag pushed by CI (the commit SHA). render.sh resolves it to digests.
IMAGE_TAG=<git-commit-sha>
ECR_REPOSITORY_PREFIX=roboshop

# Progressive rollout switches (RUNBOOK.md F): start permissive/dry-run, then tighten.
MTLS_MODE=PERMISSIVE                     # -> STRICT
AUTHZ_DRY_RUN=true                       # -> false
POLICY_ACTION=dryrun                     # -> deny
TRACE_SAMPLING_PERCENT=100               # lower for real traffic

# Argo CD source: your fork and branch.
GIT_REPO_URL=https://github.com/<you>/roboshop-ai.git
GIT_REVISION=master
SECRETS_PREFIX=roboshop
