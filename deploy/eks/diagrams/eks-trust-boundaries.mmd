%% Trust boundaries. Evidence: deploy/eks/k8s/istio/authorization.yaml, k8s/gatekeeper, k8s/apps/network-policies.yaml.
flowchart TB
  subgraph adm[1. Admission: Gatekeeper, roboshop-ai only]
    rules[registry + digest, resources, non-root, no token,<br/>labels, LoadBalancer only in istio-ingress]:::control
  end
  subgraph mesh[2. Mesh: mTLS STRICT, allow-nothing + per-edge ALLOW]
    ig[ingress gateway]:::edge --> web[web]:::edge
    web --> gw[ai-gateway]:::svc
    web --> moks[moks]:::ai
    web --> cur[currency]:::svc
    gw <--> moks
    mcp[mcp-server]:::ai --> gw
    gw --> user[user]:::svc & cat[catalogue]:::svc & cart[cart]:::svc & pay[payment]:::svc & ship[shipping]:::svc & cur
    moks --> cat & user
    user --> ship
  end
  subgraph np[3. Outside the mesh: NetworkPolicy via VPC CNI]
    mongo[(MongoDB)]:::store
    redis[(Redis)]:::store
    pg[(PostgreSQL)]:::store
    rmq[(RabbitMQ)]:::store
  end
  classDef client fill:#f8fafc,stroke:#334155,color:#0f172a
