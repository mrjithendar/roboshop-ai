%% Checkout, outbox and consumers. Evidence: ai-gateway events.py, postgres_store.py, OrderEvents.java, kafka-bridge/README.md, k8s/keda.
flowchart TB
  subgraph sync[Synchronous checkout, no mesh retries]
    br[Browser<br/>Idempotency-Key]:::client -->|1 create| gw[ai-gateway]:::svc -->|2 order| pay[payment-service]:::svc --> rzp[Razorpay test mode]:::ext
    rzp -->|3 signed webhook| gw
    gw -->|4 paid + event| led[(Ledger + outbox)]:::store
  end
  subgraph async[Events, at least once]
    led ==> ob[outbox worker]:::svc ==> ex{{RabbitMQ roboshop.orders}}:::bus
    ex ==>|order.paid| qs[[shipping.orders]]:::bus ==> sw[shipping-worker x1-4<br/>KEDA]:::svc --> pg[(PostgreSQL<br/>event_id UNIQUE)]:::store
    ex ==>|order.test-paid| qt[[test.orders]]:::bus
    ex ==> qk[[kafka.orders]]:::bus ==> kb[kafka-bridge]:::svc ==> k[(Kafka)]:::store
    qs -.->|after 5 failures| dlq[[shipping.failed]]:::bus
  end
