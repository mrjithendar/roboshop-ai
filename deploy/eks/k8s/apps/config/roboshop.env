# Non-secret runtime configuration (becomes ConfigMap roboshop-config).
# ${PUBLIC_HOST} and ${ENVIRONMENT} are substituted by ../../scripts/render.sh.
HOST=0.0.0.0
APP_ENV=production
PUBLIC_ORIGIN=https://${PUBLIC_HOST}
LOG_FORMAT=json
LOG_LEVEL=INFO
# Payments stay in Razorpay test mode; live mode needs deliberate merchant configuration.
PAYMENT_MODE=test
CHECKOUT_CURRENCIES=INR
CURRENCY_URL=http://currency-service:4111
REGISTRATION_CHALLENGE_PROVIDER=turnstile
TURNSTILE_HOSTNAME=${PUBLIC_HOST}
USER_URL=http://user-service:4109
CART_URL=http://cart-service:4107
CATALOGUE_URL=http://catalogue-service:4108
RECOMMENDATION_URL=http://catalogue-service:4108
AGENT_URL=http://moks:4103
PAYMENT_URL=http://payment-service:4105
SHIPPING_URL=http://shipping-service:4106
MONGODB_DATABASE=roboshop
# Node-local OpenTelemetry agent (k8s/observability). Telemetry export failures never fail requests.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-agent.observability.svc.cluster.local:4318/v1/traces
OTEL_SERVICE_NAMESPACE=roboshop-ai
OTEL_SERVICE_VERSION=${IMAGE_TAG}
DEPLOYMENT_ENVIRONMENT=${ENVIRONMENT}
OTEL_SDK_DISABLED=false
LANGFUSE_CAPTURE_CONTENT=false
