# Native development: python3 generate-secrets.py (creates a minimal private .env).
# This expanded example also documents optional/native-development settings.
# LLM activation is managed by superadmin in MongoDB; default provider is none.
# Shared gateway/agent authentication token (generate with secrets.token_hex(32)).
LLM_SERVICE_TOKEN=
# Approved alias -> literal IPv4 URL, explicit port. Never include credentials.
OLLAMA_ENDPOINTS_JSON={}
PUBLIC_ORIGIN=http://localhost:3000
# For npm run dev with a local collector; Minikube configures its own collector URL.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Optional Langfuse project. No prompts, user identifiers or response text are exported.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Razorpay payment service. Live mode requires an HTTPS PUBLIC_ORIGIN above.
PAYMENT_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required for Minikube/Helm; npm run dev generates an internal token if blank.
PAYMENT_SERVICE_TOKEN=

# Dedicated PostgreSQL. Set these before starting the shipping service.
SHIPPING_APP_PASSWORD=
SHIPPING_DB_PASSWORD=
SHIPPING_DATABASE_URL=
# Schema owner URL used briefly by shipping during startup (no separate service).
# Optional when SHIPPING_DATABASE_URL already belongs to the schema owner.
SHIPPING_MIGRATION_DATABASE_URL=
# Keep true for remote databases; false only for local development PostgreSQL.
SHIPPING_DB_TLS=true
SHIPPING_DB_CA_FILE=

# Local Redis and RabbitMQ. Minikube enables both integrations automatically.
CACHE_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false
MESSAGING_ENABLED=true
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=robotshop
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_TLS=false
# Gateway URL: use amqps:// with verified TLS for a remote broker.
RABBITMQ_URL=

# Optional NGINX HTTPS overlay (not needed for the default HTTP setup).
# NGINX_SERVER_NAME=shop.example.com
# TLS_CERT_DIR=/absolute/path/outside/repository/robotshop-tls
# Keep TRUST_PROXY unset for direct npm development; Minikube/Helm configure it.

# Accounts, login sessions, editable products and public store settings.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Native development: set an authenticated MongoDB URL; Minikube supplies its own.
MONGODB_URL=
MONGODB_DATABASE=robotshop
# One-time `npm run admin:bootstrap`; remove the password after successful setup.
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=

# Python interpreter for native gateway/agent/MCP (activate .venv or set absolute path).
PYTHON=python3
# MCP only: internal gateway URL and optional authenticated session, kept secret.
GATEWAY_URL=http://127.0.0.1:3000
MCP_SESSION_TOKEN=

# Customer security history. Latest login metadata remains until replaced.
LOGIN_ACTIVITY_RETENTION_DAYS=90
# Traces: native services send to the local collector; Minikube sets its internal URL.
# Do not put customer IDs, IPs or secrets in resource attributes.
OTEL_SERVICE_VERSION=0.2.0
DEPLOYMENT_ENVIRONMENT=development
OTEL_SDK_DISABLED=false

# Registration: disabled is for development/demo only. Production requires Turnstile.
APP_ENV=development
REGISTRATION_CHALLENGE_PROVIDER=disabled
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
# Set to the actual private NGINX peer CIDR(s). Empty ignores forwarding headers.
TRUSTED_PROXY_CIDRS=
# Existing MongoDB account permissions must grant this database.
MONGODB_DATABASE=robotshop
# Demo seeding is opt-in; do not use the live application connection.
# DEMO_MONGODB_URL=mongodb://<demo-only-user>:<password>@<isolated-host>:27017/?authSource=admin
