# Optional: both values are required to enable AI. Leave blank for catalogue search.
OPENAI_API_KEY=
OPENAI_MODEL=
# Set true for Docker/Helm when the agent has both credentials above.
ASSISTANT_AI_ENABLED=false
PUBLIC_ORIGIN=http://localhost:3000
# For npm run dev with a local collector; Compose configures its own collector URL.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional Langfuse project. No prompts, user identifiers or response text are exported.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Razorpay payment service. Live mode requires an HTTPS PUBLIC_ORIGIN above.
PAYMENT_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required for Compose/Helm; npm run dev generates an internal token if blank.
PAYMENT_SERVICE_TOKEN=

# Dedicated PostgreSQL. Set these before starting the shipping service.
SHIPPING_APP_PASSWORD=
SHIPPING_DB_PASSWORD=
SHIPPING_DATABASE_URL=
# Separate schema owner credentials for migrations; optional in local development.
SHIPPING_MIGRATION_DATABASE_URL=
# Keep true for remote databases; false only for local development PostgreSQL.
SHIPPING_DB_TLS=true
SHIPPING_DB_CA_FILE=

# Local Redis and RabbitMQ. Compose enables both integrations automatically.
CACHE_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false
MESSAGING_ENABLED=true
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_TLS=false
# Gateway URL: use amqps:// with verified TLS for a remote broker.
RABBITMQ_URL=

# Optional NGINX HTTPS overlay (not needed for the default HTTP setup).
# NGINX_SERVER_NAME=shop.example.com
# TLS_CERT_DIR=/absolute/path/outside/repository/robotshop-tls
# Keep TRUST_PROXY unset for direct npm development; Compose/Helm configure it.
