# Replace repository URL, revision and image values before applying.
# Manual sync only; this example does not deploy anything automatically.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: robotshop-ai
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/YOUR-ORG/robotshop-ai.git
    targetRevision: main
    path: infrastructure/helm/robotshop-ai
    helm:
      values: |
        image:
          repository: YOUR-REGISTRY/robotshop-ai
          tag: YOUR-IMMUTABLE-TAG
  destination:
    server: https://kubernetes.default.svc
    namespace: robotshop-ai
  syncPolicy:
    syncOptions:
      - CreateNamespace=true
