{
  "uid": "roboshop-services",
  "title": "RoboShop \u00b7 Services",
  "description": "Request rate, errors, latency and dependencies for RoboShop microservices (Prometheus).",
  "tags": [
    "roboshop",
    "minikube",
    "prometheus",
    "services"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "roboshop-prometheus"
        },
        "query": {
          "query": "label_values(roboshop_http_requests_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(roboshop_http_requests_total, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
