      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "topk(20, round(sum by (service, route, status) (increase(roboshop_http_requests_total{service=~\"$service\"}[$__range]))) > 0)",
          "instant": true,
          "range": false,
          "format": "table"
