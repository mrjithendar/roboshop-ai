    {
      "type": "table",
      "title": "Top events",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "roboshop-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "topk(20, sum by (service_name, event) (count_over_time({namespace=~\"$namespace\", service_name=~\"$service\"} | regexp `event=(?P<event>\\S+)` [$__range])))",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Lines"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lines",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
