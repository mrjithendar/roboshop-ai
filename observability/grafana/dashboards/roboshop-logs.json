      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "sum by (service_name) (count_over_time({namespace=~\"$namespace\", service_name=~\"$service\"} |~ `(?i)level=(error|fatal|warn)` [$__auto]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range"
