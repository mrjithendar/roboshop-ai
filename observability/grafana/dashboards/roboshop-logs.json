    {
      "type": "timeseries",
      "title": "p95 request duration from logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "roboshop-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "quantile_over_time(0.95, {namespace=~\"$namespace\", service_name=~\"$service\"} |= `event=request_completed` | logfmt | unwrap duration_ms | __error__=\"\" [$__auto]) by (service_name)",
          "legendFormat": "{{service_name}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Slowest routes from logs (p95 ms, selected range)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "roboshop-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "topk(15, quantile_over_time(0.95, {namespace=~\"$namespace\", service_name=~\"$service\"} |= `event=request_completed` | logfmt | route!=\"\" | unwrap duration_ms | __error__=\"\" [$__range]) by (service_name, route))",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "p95"
