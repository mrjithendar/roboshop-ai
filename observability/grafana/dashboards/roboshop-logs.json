      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "topk(20, sum by (service_name, error_type, error_code) (count_over_time({namespace=~\"$namespace\", service_name=~\"$service\"} | logfmt | error_type!=\"\" or error_code!=\"\" [$__range])))",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Lines"
