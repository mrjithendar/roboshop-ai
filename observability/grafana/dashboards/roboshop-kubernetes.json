{
  "uid": "roboshop-kubernetes",
  "title": "RoboShop \u00b7 Kubernetes (Minikube)",
  "description": "Cluster, node, namespace and pod resource usage for the mk4 Minikube cluster (cAdvisor + kubelet).",
  "tags": [
    "roboshop",
    "minikube",
    "prometheus",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "roboshop-prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{container!=\"\"}, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(container_memory_working_set_bytes{container!=\"\"}, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
