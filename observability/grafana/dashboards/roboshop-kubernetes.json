    {
      "type": "table",
      "title": "Memory use vs limit",
      "description": "Working set as a share of the container memory limit. Near 100% means OOM-kill risk.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sort_desc(sum by (namespace, pod, container) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\",namespace=~\"$namespace\"}) / sum by (namespace, pod, container) (container_spec_memory_limit_bytes{container!=\"\",container!=\"POD\",namespace=~\"$namespace\"} > 0))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Used / limit"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Used / limit",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "CPU throttling (last 5m)",
      "description": "Share of CPU periods throttled by the limit. Sustained >25% slows the service.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sort_desc(sum by (namespace, pod, container) (rate(container_cpu_cfs_throttled_periods_total{container!=\"\",container!=\"POD\",namespace=~\"$namespace\"}[5m])) / sum by (namespace, pod, container) (rate(container_cpu_cfs_periods_total{container!=\"\",container!=\"POD\",namespace=~\"$namespace\"}[5m])) > 0.01)",
          "instant": true,
          "range": false,
          "format": "table"
