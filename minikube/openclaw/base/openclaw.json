{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "publicOrigin": "https://jithendar.com",
    "controlUi": {
      "basePath": "/openclaw",
      "allowedOrigins": [
        "https://jithendar.com"
      ]
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "rateLimit": {
        "maxAttempts": 5,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": false
      }
    },
    "terminal": {
      "enabled": false
    },
    "uploads": {
      "enabled": false
    },
    "cliAgents": {
      "enabled": false
    },
    "trustedProxies": [
      "10.244.9.16/32"
    ]
  },
  "browser": {
    "enabled": false
  },
  "tools": {
    "allow": [
      "bundle-mcp"
    ],
    "deny": [
      "group:runtime",
      "group:fs",
      "group:web",
      "group:ui",
      "group:nodes",
      "group:automation",
      "group:messaging",
      "group:media"
    ],
    "elevated": {
      "enabled": false
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.4-mini"
      },
      "timeoutSeconds": 120,
      "maxConcurrent": 2,
      "skipBootstrap": true
    },
    "entries": {
      "orchestrator": {
        "name": "Orchestrator Operations",
        "workspace": "/workspaces/orchestrator",
        "skills": [],
        "tools": {
          "allow": [
            "ops-orchestrator__ops_kubernetes",
            "ops-orchestrator__ops_argocd",
            "ops-orchestrator__ops_observability",
            "ops-orchestrator__ops_github",
            "ops-orchestrator__ops_aws",
            "ops-orchestrator__ops_roboshop",
            "ops-orchestrator__ops_blog"
          ]
        }
      },
      "sre": {
        "name": "Sre Operations",
        "workspace": "/workspaces/sre",
        "skills": [],
        "tools": {
          "allow": [
            "ops-sre__ops_kubernetes",
            "ops-sre__ops_roboshop"
          ]
        }
      },
      "argocd": {
        "name": "Argocd Operations",
        "workspace": "/workspaces/argocd",
        "skills": [],
        "tools": {
          "allow": [
            "ops-argocd__ops_argocd"
          ]
        }
      },
      "github": {
        "name": "Github Operations",
        "workspace": "/workspaces/github",
        "skills": [],
        "tools": {
          "allow": [
            "ops-github__ops_github"
          ]
        }
      },
      "aws": {
        "name": "Aws Operations",
        "workspace": "/workspaces/aws",
        "skills": [],
        "tools": {
          "allow": [
            "ops-aws__ops_aws"
          ]
        }
      },
      "observability": {
        "name": "Observability Operations",
        "workspace": "/workspaces/observability",
        "skills": [],
        "tools": {
          "allow": [
            "ops-observability__ops_observability"
          ]
        }
      },
      "roboshop": {
        "name": "Roboshop Operations",
        "workspace": "/workspaces/roboshop",
        "skills": [],
        "tools": {
          "allow": [
            "ops-roboshop__ops_roboshop",
            "ops-roboshop__ops_kubernetes",
            "ops-roboshop__ops_observability",
            "ops-roboshop__ops_argocd"
          ]
        }
      },
      "blog": {
        "name": "Blog Operations",
        "workspace": "/workspaces/blog",
        "skills": [],
        "tools": {
          "allow": [
            "ops-blog__ops_blog"
          ]
        }
      }
    },
    "ownership": "explicit"
  },
  "mcp": {
    "servers": {
      "ops-orchestrator": {
        "url": "http://openclaw-operations.openclaw.svc:4180/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 100000,
        "headers": {
          "Authorization": "Bearer ${OPS_ORCHESTRATOR_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "ops_kubernetes",
            "ops_argocd",
            "ops_observability",
            "ops_github",
            "ops_aws",
            "ops_roboshop",
            "ops_blog"
          ]
        }
      },
      "ops-sre": {
        "url": "http://openclaw-operations.openclaw.svc:4180/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 100000,
        "headers": {
          "Authorization": "Bearer ${OPS_SRE_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "ops_kubernetes",
            "ops_roboshop"
          ]
        }
      },
      "ops-argocd": {
        "url": "http://openclaw-operations.openclaw.svc:4180/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 100000,
        "headers": {
          "Authorization": "Bearer ${OPS_ARGOCD_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "ops_argocd"
          ]
        }
      },
      "ops-github": {
        "url": "http://openclaw-operations.openclaw.svc:4180/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 100000,
        "headers": {
          "Authorization": "Bearer ${OPS_GITHUB_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "ops_github"
          ]
        }
      },
      "ops-aws": {
        "url": "http://openclaw-operations.openclaw.svc:4180/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 100000,
        "headers": {
          "Authorization": "Bearer ${OPS_AWS_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "ops_aws"
          ]
        }
      },
      "ops-observability": {
        "url": "http://openclaw-operations.openclaw.svc:4180/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 100000,
        "headers": {
          "Authorization": "Bearer ${OPS_OBSERVABILITY_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "ops_observability"
          ]
        }
      },
      "ops-roboshop": {
        "url": "http://openclaw-operations.openclaw.svc:4180/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 100000,
        "headers": {
          "Authorization": "Bearer ${OPS_ROBOSHOP_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "ops_roboshop",
            "ops_kubernetes",
            "ops_observability",
            "ops_argocd"
          ]
        }
      },
      "ops-blog": {
        "url": "http://openclaw-operations.openclaw.svc:4180/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 100000,
        "headers": {
          "Authorization": "Bearer ${OPS_BLOG_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "ops_blog"
          ]
        }
      }
    }
  },
  "logging": {
    "consoleStyle": "json",
    "level": "info",
    "audit": {
      "enabled": true,
      "messages": "off",
      "executionIdentity": false
    }
  },
  "diagnostics": {
    "enabled": true,
    "otel": {
      "enabled": true,
      "endpoint": "http://otel-collector.roboshop-ai.svc:4318",
      "protocol": "http/protobuf",
      "serviceName": "openclaw",
      "traces": true,
      "metrics": false,
      "logs": false,
      "captureContent": false
    }
  },
  "proxy": {
    "proxyUrl": "http://openclaw-egress.openclaw.svc:3128"
  },
  "plugins": {
    "allow": [
      "diagnostics-otel",
      "diagnostics-prometheus",
      "openai"
    ],
    "load": {
      "paths": [
        "/opt/openclaw-plugins/node_modules/@openclaw/diagnostics-otel",
        "/opt/openclaw-plugins/node_modules/@openclaw/diagnostics-prometheus"
      ]
    },
    "entries": {
      "diagnostics-otel": {
        "enabled": true
      },
      "diagnostics-prometheus": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      }
    }
  }
}
