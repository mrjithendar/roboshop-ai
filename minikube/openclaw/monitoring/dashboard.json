{
  "title": "OpenClaw Unified Operations",
  "uid": "openclaw-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Gateway availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"openclaw-operations\"}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tool failure rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(openclaw_tool_calls_total{outcome!=\"ok\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tool p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,tool) (rate(openclaw_tool_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Authentication failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(openclaw_auth_failures_total[5m])"
        }
      ]
    },
    {
      "id": 5,
      "title": "Container memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"openclaw\",container!=\"\"})"
        }
      ]
    },
    {
      "id": 6,
      "title": "AI Gateway p99 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"ai-gateway\"}[5m])))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Agent p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(openclaw_run_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 8,
      "title": "LLM p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(openclaw_model_call_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 9,
      "title": "LLM token usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type) (rate(openclaw_model_tokens_total[5m]))"
        }
      ]
    },
    {
      "id": 10,
      "title": "OpenClaw telemetry availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"openclaw-gateway-telemetry\"}"
        }
      ]
    }
  ]
}
