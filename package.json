{
  "name": "roboshop-ai",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs services/*/tests/*.test.mjs services/web/frontend/tests/*.test.mjs",
    "ingest": "node --env-file-if-exists=.env services/catalogue-service/import.mjs",
    "mcp": "set -a && { [ ! -f .env ] || . ./.env; } && set +a && ${PYTHON:-python3} services/mcp-server/server.py",
    "shipping:build": "sh services/shipping-service/gradlew -p services/shipping-service --no-daemon test bootJar",
    "pretest": "npm run frontend:build && npm run shipping:build && npm run test:python",
    "test:nginx": "NGINX_TEST=true node --test tests/nginx.test.mjs",
    "frontend:build": "npm --prefix services/web/frontend run build",
    "frontend:typecheck": "npm --prefix services/web/frontend run typecheck",
    "pretest:nginx": "npm run frontend:build",
    "admin:bootstrap": "set -a && { [ ! -f .env ] || . ./.env; } && set +a && ${PYTHON:-python3} services/user-service/bootstrap.py",
    "test:python": "${PYTHON:-python3} -m unittest discover -s tests/python -v && ${PYTHON:-python3} -m unittest discover -s services/ai-gateway/tests -v && ${PYTHON:-python3} -m unittest discover -s services/user-service/tests -v && ${PYTHON:-python3} -m unittest discover -s services/moks/tests -v"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "typescript": "7.0.2"
  }
}
