# Copy to .env.local for local development. No secrets are needed in Phase 2.

# Deployment environment. Only "production" may be indexed by search engines;
# every other value adds noindex (meta tag at build time, X-Robots-Tag at request time).
APP_ENV=development

# Canonical origin used for canonical URLs, sitemaps, feeds and JSON-LD. No trailing slash.
SITE_URL=https://jithendar.com

# Optional: read content from another directory (tests use tests/fixtures/content).
# CONTENT_DIR=

# --- Media storage: Cloudflare R2 (S3-compatible API). Server-side only; never prefix with NEXT_PUBLIC_. ---
# Objects are written to jithendar/www/media/{type}/{yyyy}/{mm}/{id}.{ext} inside this bucket.
# Without these, an admin can configure R2 under Admin → Storage instead (stored encrypted in Postgres).
# R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# R2_BUCKET=jithendar-media
# R2_ACCESS_KEY_ID=replace-me
# R2_SECRET_ACCESS_KEY=replace-me
# Optional public delivery domain connected to the bucket (large video/audio/PDF redirect here):
# R2_PUBLIC_BASE_URL=https://media.jithendar.com
# Optional API endpoint override (EU jurisdiction bucket, or a local S3 emulator for development):
# R2_ENDPOINT=https://0123456789abcdef0123456789abcdef.eu.r2.cloudflarestorage.com

# --- "Generate image" in the editor: Gemini API (server-side only). Off unless both are set. ---
# GEMINI_API_KEY=replace-me
# Model code from https://ai.google.dev/gemini-api/docs/models (an image-generation model).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=1K                      # 512 | 1K | 2K | 4K (model-dependent)
# GEMINI_IMAGE_TIMEOUT_MS=90000
# GEMINI_IMAGE_USER_HOURLY_LIMIT=10
# GEMINI_IMAGE_USER_CONCURRENCY=1
# GEMINI_IMAGE_DAILY_LIMIT=50               # whole site, per rolling 24 hours

# Local development without DATABASE_URL uses an embedded database in .data/pglite.
# PGLITE_DIR=.data/pglite
